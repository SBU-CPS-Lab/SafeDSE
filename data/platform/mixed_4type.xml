<?xml version="1.0" encoding="UTF-8"?>
<!-- SafeDSE platform catalogue (docs/inputs.md#platform-catalogue).
     An FCR template is something you physically buy: its cores share power,
     clock and substrate, so they fail together.  The DSE decides how many of
     each to instantiate. -->
<platform name="mixed_four_types">

  <!-- expensive, certifiable up to SIL 4, supports partitioning -->
  <fcr_template name="R-card" max_instances="3" monetary="120">
    <processor model="cortexR" count="2" max_sil="4" mem="64000"
               partitionable="false" partition_cost="0">
      <mode name="standard"    cycle="1"   dynPower="180" area="14" monetary="40"/>
      <mode name="eco"         cycle="1.3" dynPower="95"  area="14" monetary="40"/>
    </processor>
  </fcr_template>

  <!-- a SECOND high-SIL core type, of different lineage. Needed for DIVERSE at
       SIL 3: defending against systematic faults requires two implementations
       on genuinely different processors, so one certifiable type is not enough
       however many instances of it you buy. -->
  <fcr_template name="P-card" max_instances="3" monetary="140">
    <processor model="ppcE200" count="2" max_sil="4" mem="48000"
               partitionable="false" partition_cost="0">
      <mode name="standard" cycle="1.15" dynPower="150" area="12" monetary="45"/>
    </processor>
  </fcr_template>

  <!-- cheap, capped at SIL 2, no certified isolation available -->
  <fcr_template name="M-card" max_instances="4" monetary="25">
    <processor model="cortexM" count="4" max_sil="2" mem="16000"
               partitionable="false" partition_cost="0">
      <mode name="standard"    cycle="1.6" dynPower="40"  area="4" monetary="8"/>
      <mode name="performance" cycle="1.2" dynPower="72"  area="5" monetary="11"/>
    </processor>
  </fcr_template>


  <!-- third SIL-4-capable lineage, added so N-version programming at SIL 3 is
       placeable: N mutually diverse components need N types EACH certifiable
       at their SIL, and two high-SIL types are not enough for N=3. -->
  <fcr_template name="S-card" max_instances="3" monetary="150">
    <processor model="sparcLEON" count="2" max_sil="4" mem="48000"
               partitionable="false" partition_cost="0">
      <mode name="standard" cycle="1.25" dynPower="160" area="13" monetary="48"/>
    </processor>
  </fcr_template>

  <interconnect>
    <TDMA_bus name="TDMA-bus" x-dimension="8" flitSize="32" tdma_slots="16"
              maxSlotsPerProc="8">
      <mode name="default" cycleLength="1"/>
    </TDMA_bus>
  </interconnect>
</platform>
