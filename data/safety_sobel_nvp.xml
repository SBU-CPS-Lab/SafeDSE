<?xml version="1.0"?>
<!-- get_pixel at SIL 3 with the fault model set to `both`, which is the only
     configuration in which nvp_three_version is admissible. Everything else is
     SIL 0 so that the downstream actors take pattern `none` and therefore have
     no input_fanout: an explicit voter feeding a fanout-using consumer needs a
     conjunctive edge guard, which the model cannot yet express. -->
<safety fault_model="both" cost_profile="myklebust2015" allow_promotion="true">
  <default sil="0"/>
  <actor name="get_pixel" sil="3"/>
</safety>
