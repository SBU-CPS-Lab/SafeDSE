  S1 -> G18 [arrowhead=normal];
  S1 -> G25 [arrowhead=normal];
  S1 -> G28 [arrowhead=normal];
  S1 -> G35 [arrowhead=normal];
  S1 -> G36 [arrowhead=normal];
  S1 -> G37 [arrowhead=normal];
  G2 -> G3 [arrowhead=normal];
  G2 -> S2 [arrowhead=normal];
  G2 -> C5 [arrowhead=onormal style=solid];
  G2 -> C6 [arrowhead=onormal style=solid];
