  C24 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C24\nPattern nvp_three_version [Armoush 2010,\nIEC 61508-7 C.4.4]: N-version programming\nwith three independently developed\nversions and an explicit majority voter.\nThe versions compute from the same inputs\nand the voter selects the majority result,\nmasking a fault in any one version.\nAttainable SIL [3, 4]; covers random_hw,\nsystematic_sw; fails masking; voter\nexplicit."];
  G25 [shape=box label="G25\nA fault in any single version is masked by\nthe majority of the remaining versions.\n[nvp_three_version/SC1]"];
  S11 [shape=parallelogram label="S11\nAchieved through the Voting tactic\n(Masking): Mask the failure of a subsystem\nso that the failure does not propagate to\nother systems."];
  C25 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C25\nVoting: Voting makes a failure\ntransparent. It does not repair the\nfailure, but hides it by choosing a\ncorrect result from redundant subsystems,\ndeciding for the majority of the output\nvalues."];
  C26 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C26\nCandidate methods from the standard: IEC\n61508-7 A.1.4 voter; IEC 61508-7 A.6.5\ninput comparison/voting"];
  G26 [shape=box style=dashed color="#b00020" label="G26\nAn IEC 61508 method realising Voting is\nimplemented in compJah, and its\neffectiveness for the faults of concern is\ndemonstrated.  <>UNDEVELOPED"];
  G27 [shape=box label="G27\nA random hardware fault affects at most\none of the three versions.\n[nvp_three_version/SC2]"];
  S12 [shape=parallelogram label="S12\nAchieved through the Replication\nRedundancy tactic (Redundancy):\nIntroduction of a redundant system which\nallows detection or masking of random\nhardware failures (not systematic\nfailures)."];
