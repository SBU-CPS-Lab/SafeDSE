  G28 [shape=box label="G28\nIn the deployed mapping, the replicated\ncomponents are deployed on hardware that\ndoes not share a single point of random\nhardware failure."];
  Sn13 [shape=circle label="Sn13\nIndependent re-check of the solution:\nDIFFERENT_FCR between compJah and\ncompJah/version_2: cores 1/7, fault\ncontainment regions 1/4, core types\ncortexR/ppcE200."];
  Sn14 [shape=circle label="Sn14\nIndependent re-check of the solution:\nDIFFERENT_FCR between compJah and\ncompJah/version_3: cores 1/29, fault\ncontainment regions 1/11, core types\ncortexR/sparcLEON."];
  Sn15 [shape=circle label="Sn15\nIndependent re-check of the solution:\nDIFFERENT_FCR between compJah/version_2\nand compJah/version_3: cores 7/29, fault\ncontainment regions 4/11, core types\nppcE200/sparcLEON."];
  Sn16 [shape=circle label="Sn16\nIndependent re-check of the solution:\nDIFFERENT_FCR between compJah and\ncompJah/voter: cores 1/7, fault\ncontainment regions 1/4, core types\ncortexR/ppcE200."];
  C28 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C28\nCandidate methods from the standard: IEC\n61508-7 A.2.1 tests by redundant hardware;\nIEC 61508-7 A.2.5 monitored redundancy;\nIEC 61508-7 A.3.5 reciprocal comparison by\nsoftware; IEC 61508-7 A.4.5 block\nreplication; IEC 61508-7 A.6.3\nmulti-channel output; IEC 61508-7 A.7.3\ncomplete hardware redundancy; IEC 61508-7\nA.7.5 transmission redundancy"];
  G29 [shape=box style=dashed color="#b00020" label="G29\nAn IEC 61508 method realising Replication\nRedundancy is implemented in compJah, and\nits effectiveness for the faults of\nconcern is demonstrated.  <>UNDEVELOPED"];
  G30 [shape=box label="G30\nA systematic fault in one version is not\nreproduced by the other two versions.\n[nvp_three_version/SC3]"];
  S13 [shape=parallelogram label="S13\nAchieved through the Diverse Redundancy\ntactic (Redundancy): Introduction of a\nredundant system which allows detection or\nmasking of failures in the specification\nor implementation as well as random\nhardware failures."];
  C29 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C29\nDiverse Redundancy: Redundant components\nuse different implementations which were\ndeveloped independently from the same\nspecification. Applied at specification\nlevel it further requires the requirement\nspecifications themselves to be produced\nby individual teams."];
  G31 [shape=box label="G31\nIn the deployed mapping, the diverse\ncomponents are deployed on distinct\nprocessor types."];
  Sn17 [shape=circle label="Sn17\nIndependent re-check of the solution:\nDIVERSE between compJah and\ncompJah/version_2: cores 1/7, fault\ncontainment regions 1/4, core types\ncortexR/ppcE200."];
  Sn18 [shape=circle label="Sn18\nIndependent re-check of the solution:\nDIVERSE between compJah and\ncompJah/version_3: cores 1/29, fault\ncontainment regions 1/11, core types\ncortexR/sparcLEON."];
  Sn19 [shape=circle label="Sn19\nIndependent re-check of the solution:\nDIVERSE between compJah/version_2 and\ncompJah/version_3: cores 7/29, fault\ncontainment regions 4/11, core types\nppcE200/sparcLEON."];
  A4 [shape=ellipse style=filled fillcolor="#fff6d5" label="A4 (A)\nDistinct core types give distinct\ntoolchains and object code, not\nindependent design. Design independence\nremains an undischarged claim. The mapping\nevidence below establishes the deployment\nproperty only."];
  C30 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C30\nCandidate methods from the standard: IEC\n61508-7 A.7.6 information redundancy; IEC\n61508-7 A.13.2 cross-monitoring of\nmultiple actuators; IEC 61508-7 B.1.4\ndiverse hardware; IEC 61508-7 C.4.4\ndiverse programming"];
  G32 [shape=box style=dashed color="#b00020" label="G32\nAn IEC 61508 method realising Diverse\nRedundancy is implemented in compJah, and\nits effectiveness for the faults of\nconcern is demonstrated.  <>UNDEVELOPED"];
  G33 [shape=box label="G33\nA disagreement among the versions is\ndetected before the result leaves the\ncomponent. [nvp_three_version/SC4]"];
  S14 [shape=parallelogram label="S14\nAchieved through the Comparison tactic\n(Checking): Detection of discrepancies of\nredundant system outputs."];
  C31 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C31\nComparison: Tests whether the outputs of\nfully redundant subsystems are equal in\norder to detect failures. Usually implies\nthe use of a redundancy tactic."];
  C32 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C32\nCandidate methods from the standard: IEC\n61508-7 A.1.3 comparator; IEC 61508-7\nA.6.5 input comparison/voting"];
  G34 [shape=box style=dashed color="#b00020" label="G34\nAn IEC 61508 method realising Comparison\nis implemented in compJah, and its\neffectiveness for the faults of concern is\ndemonstrated.  <>UNDEVELOPED"];
  G35 [shape=box label="G35\nActor rastaFilter of application c_rasta,\nallocated SIL 1, attains SIL 1 in the\ndeployed architecture."];
  C33 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C33\nrastaFilter is unfolded into 1 concurrent\ncopy, bound to core 13, implemented at SIL\n1."];
  Sn20 [shape=circle label="Sn20\nIndependent re-check of the solution:\nevery active copy of rastaFilter is\nimplemented at or above its allocated SIL\nand runs on a core provisioned to at least\nthat level."];
  G36 [shape=box label="G36\nEvery copy of rastaFilter is implemented\nat SIL 1 or above and is not hosted on a\ncore provisioned below that level."];
  S15 [shape=parallelogram label="S15\nArgument by development process alone: no\nstructural safety pattern is applied."];
  C34 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C34\nIEC 61508 expects diagnostic coverage from\nSIL 2 upward, so process alone is\nadmissible only to SIL 1 (Q20). The\nexploration enforced this ceiling when\nchoosing the pattern."];
  G37 [shape=box style=dashed color="#b00020" label="G37\nrastaFilter is developed and verified to\nSIL 1 in accordance with IEC 61508-3.  <>UNDEVELOPED"];
  G38 [shape=box label="G38\nActor backEnd of application c_rasta,\nallocated SIL 2, attains SIL 2 in the\ndeployed architecture."];
  C35 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C35\nbackEnd is unfolded into 1 concurrent\ncopy, bound to core 2, implemented at SIL\n2."];
  Sn21 [shape=circle label="Sn21\nIndependent re-check of the solution:\nevery active copy of backEnd is\nimplemented at or above its allocated SIL\nand runs on a core provisioned to at least\nthat level."];
  G39 [shape=box label="G39\nEvery copy of backEnd is implemented at\nSIL 2 or above and is not hosted on a core\nprovisioned below that level."];
  C36 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C36\nComponents introduced by\nlow_sil_diverse_doer_checker for backEnd:\nchecker on core 14 at SIL 2."];
  S16 [shape=parallelogram label="S16\nArgument by application of the\nlow_sil_diverse_doer_checker safety\narchitecture pattern, over each of its\ngeneral scenarios."];
  C37 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C37\nPattern low_sil_diverse_doer_checker\n[koopman, Low SIL Doer/Checker Pair,\narmoush, HtD]: low_sil_doer_checker with\nthe checker additionally required to be a\nDIVERSE implementation on a different\nprocessor type. Added because the encoded\nKoopman catalogue has a hole: at SIL 2 the\nseparated pair defends against random\nhardware faults and the co-located pair\nagainst systematic software faults, but\nnothing covers BOTH. Separation alone does\nnot help against a systematic fault, since\nan identical checker on another core\nreproduces the same mistake. The cost is\nArmoush's heterogeneous-duplex figure: two\nindependent developments, roughly 200% of\none, against ~100% for an identical copy.\nAttainable SIL [1, 2]; covers random_hw,\nsystematic_sw; fails active; voter folded."];
  G40 [shape=box label="G40\nAn implausible output of the doer is\ndetected by the checker.\n[low_sil_diverse_doer_checker/SC1]"];
  S17 [shape=parallelogram label="S17\nAchieved through the Sanity Check tactic\n(Checking): Detection of implausible\nsystem outputs or states."];
  C38 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C38\nSanity Check: Checks whether a system\nstate or value remains within a valid\nrange which can be defined in the system\nspecification or which is based on\nknowledge about the internal structure or\nnature of the system."];
  C39 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C39\nCandidate methods from the standard: IEC\n61508-7 A.1.2 monitoring relay contacts;\nIEC 61508-7 A.2.7 analog signal\nmonitoring; IEC 61508-7 A.3.1-A.3.3\nself-tests; IEC 61508-7 A.4.1-A.4.4\nchecksums; IEC 61508-7 A.5.1-A.5.5 RAM\ntests; IEC 61508-7 A.6.1 test pattern; IEC\n61508-7 A.9 temporal and logical program\nmonitoring; IEC 61508-7 C.3.3 assertion\nprogramming; IEC 61508-7 C.5.3 interface\nchecking"];
  G41 [shape=box style=dashed color="#b00020" label="G41\nAn IEC 61508 method realising Sanity Check\nis implemented in backEnd, and its\neffectiveness for the faults of concern is\ndemonstrated.  <>UNDEVELOPED"];
  G42 [shape=box label="G42\nA random hardware fault in the doer's\nfault containment region does not prevent\ndetection.\n[low_sil_diverse_doer_checker/SC2]"];
  S18 [shape=parallelogram label="S18\nAchieved through the Replication\nRedundancy tactic (Redundancy):\nIntroduction of a redundant system which\nallows detection or masking of random\nhardware failures (not systematic\nfailures)."];
  C40 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C40\nReplication Redundancy: Introduction of a\nredundant system of the same\nimplementation. The redundant systems\nmaintain the same functionality, use\nidentical hardware, and run the same\nsoftware implementation."];
  G43 [shape=box label="G43\nIn the deployed mapping, the replicated\ncomponents are deployed on hardware that\ndoes not share a single point of random\nhardware failure."];
  Sn22 [shape=circle label="Sn22\nIndependent re-check of the solution:\nDIFFERENT_FCR between backEnd and\nbackEnd/checker: cores 2/14, fault\ncontainment regions 1/7, core types\ncortexR/cortexM."];
  C41 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C41\nCandidate methods from the standard: IEC\n61508-7 A.2.1 tests by redundant hardware;\nIEC 61508-7 A.2.5 monitored redundancy;\nIEC 61508-7 A.3.5 reciprocal comparison by\nsoftware; IEC 61508-7 A.4.5 block\nreplication; IEC 61508-7 A.6.3\nmulti-channel output; IEC 61508-7 A.7.3\ncomplete hardware redundancy; IEC 61508-7\nA.7.5 transmission redundancy"];
  G44 [shape=box style=dashed color="#b00020" label="G44\nAn IEC 61508 method realising Replication\nRedundancy is implemented in backEnd, and\nits effectiveness for the faults of\nconcern is demonstrated.  <>UNDEVELOPED"];
  G45 [shape=box label="G45\nA systematic fault in the doer's\nimplementation is not reproduced by the\nchecker.\n[low_sil_diverse_doer_checker/SC3]"];
  S19 [shape=parallelogram label="S19\nAchieved through the Diverse Redundancy\ntactic (Redundancy): Introduction of a\nredundant system which allows detection or\nmasking of failures in the specification\nor implementation as well as random\nhardware failures."];
  C42 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C42\nDiverse Redundancy: Redundant components\nuse different implementations which were\ndeveloped independently from the same\nspecification. Applied at specification\nlevel it further requires the requirement\nspecifications themselves to be produced\nby individual teams."];
  G46 [shape=box label="G46\nIn the deployed mapping, the diverse\ncomponents are deployed on distinct\nprocessor types."];
  Sn23 [shape=circle label="Sn23\nIndependent re-check of the solution:\nDIVERSE between backEnd and\nbackEnd/checker: cores 2/14, fault\ncontainment regions 1/7, core types\ncortexR/cortexM."];
  A5 [shape=ellipse style=filled fillcolor="#fff6d5" label="A5 (A)\nDistinct core types give distinct\ntoolchains and object code, not\nindependent design. Design independence\nremains an undischarged claim. The mapping\nevidence below establishes the deployment\nproperty only."];
  C43 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C43\nCandidate methods from the standard: IEC\n61508-7 A.7.6 information redundancy; IEC\n61508-7 A.13.2 cross-monitoring of\nmultiple actuators; IEC 61508-7 B.1.4\ndiverse hardware; IEC 61508-7 C.4.4\ndiverse programming"];
  G47 [shape=box style=dashed color="#b00020" label="G47\nAn IEC 61508 method realising Diverse\nRedundancy is implemented in backEnd, and\nits effectiveness for the faults of\nconcern is demonstrated.  <>UNDEVELOPED"];
  G48 [shape=box label="G48\nNo core hosts software of differing\nintegrity without certified partitioning,\nand every core is provisioned to at least\nthe highest integrity level it hosts."];
  C44 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C44\nKoopman's rule 2: absent certified\npartitioning, all software on a processor\nmust be developed to the highest integrity\nlevel present on it. Whether a core type\ncan provide such partitioning is declared\nper core type by the platform (Q18)."];
  S20 [shape=parallelogram label="S20\nAchieved through the Barrier tactic\n(Isolation): protect a subsystem from\ninfluences of other subsystems."];
  Sn24 [shape=circle label="Sn24\nIndependent re-check of the solution: all\n34 core slots re-examined against their\ntype ceiling and against the set of\nintegrity levels actually hosted."];
  G49 [shape=box label="G49\nThe deployed mapping and static order meet\nthe declared timing requirements, in the\nfault-free and in the degraded case alike."];
  C45 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C45\nIteration period per application: [1180].\nTiming is a safety property here because a\nreplica that misses its deadline cannot\nperform the check the pattern credits it\nwith."];
  Sn25 [shape=circle label="Sn25\nIndependent re-check of the solution: the\nmapping-and-schedule-aware graph was\nrebuilt from the returned assignment and\nits period computed twice by disjoint\nmethods -- Karp's maximum cycle ratio and\nmax-plus self-timed simulation -- both\nagreeing with the period the solver\nreported."];
  Sn26 [shape=circle label="Sn26\nIndependent re-check of the solution: the\nreported period is at least the total\nexecution demand of the busiest core, the\nbound that a static order left open as a\nchain silently loses."];
  G50 [shape=box style=dashed color="#b00020" label="G50\nEvery software component is developed,\nverified and validated to its allocated\nsafety integrity level in accordance with\nIEC 61508-3.  <>UNDEVELOPED"];
  C46 [shape=box style="rounded,filled" fillcolor="#f0f0f0" label="C46\nIntegrity levels to be discharged by\nprocess, as active component counts: SIL\n1: 4, SIL 2: 2, SIL 3: 8. Components\nimplemented above their allocated level\nwere promoted to satisfy Koopman's rule 2;\nthe cost of that promotion is what the\nexploration minimised."];
